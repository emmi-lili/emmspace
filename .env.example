# Supabase configuration.
# Copy this file to `.env` and fill in the values from your Supabase project
# (Project Settings -> API). Both vars are safe to expose in the client — the
# anon key is public and protected by Row Level Security.
#
# Leave them empty to run the app entirely on bundled mock data.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
